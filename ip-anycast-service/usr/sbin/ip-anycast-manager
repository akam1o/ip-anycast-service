#!/bin/bash
set -euo pipefail

# Paths
CONFIG_FILE="/etc/ip-anycast/ip-anycast.conf"
TEMPLATE_FILE="/etc/ip-anycast/bird.template"
BIRD_CONF="/etc/bird/bird.conf"
INTERFACE_TOUCHED=0

warn() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [ip-anycast] WARNING: $1" >&2
}

# 1. Load Configuration
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Config file $CONFIG_FILE not found."
    exit 1
fi

# Refuse to source an unsafe config file (ownership/perms).
if ! command -v stat >/dev/null 2>&1; then
    echo "Error: stat not found; refusing to load $CONFIG_FILE without permission checks." >&2
    exit 1
fi

if ! owner_uid="$(stat -c '%u' "$CONFIG_FILE" 2>/dev/null)"; then
    echo "Error: Unable to read owner UID for $CONFIG_FILE." >&2
    exit 1
fi
if ! perms="$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null)"; then
    echo "Error: Unable to read permissions for $CONFIG_FILE." >&2
    exit 1
fi
if [ "$owner_uid" != "0" ]; then
    echo "Error: Refusing to load $CONFIG_FILE (owner uid is '$owner_uid', expected '0')." >&2
    exit 1
fi
group_write=$(( (10#$perms / 10) % 10 ))
other_write=$(( 10#$perms % 10 ))
if [ $((group_write & 2)) -ne 0 ] || [ $((other_write & 2)) -ne 0 ]; then
    echo "Error: Refusing to load $CONFIG_FILE (writable by group/others: mode $perms)." >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"
BIRD_CONF="${BIRD_CONF:-/etc/bird/bird.conf}"
BIRD_SERVICE="${BIRD_SERVICE:-bird}"
BIRD_CONTROL_SOCKET="${BIRD_CONTROL_SOCKET:-}"

# Logging helper
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [ip-anycast] $1"
}

require_var() {
    local name="$1"
    local value="${!name-}"
    if [ -z "${value}" ]; then
        echo "Error: Required config '$name' is missing or empty in $CONFIG_FILE." >&2
        exit 1
    fi
}

require_positive_integer() {
    local name="$1"
    local value="${!name-}"
    if ! [[ "$value" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: Config '$name' must be a positive integer number of seconds in $CONFIG_FILE." >&2
        exit 1
    fi
}

validate_bird_runtime_config() {
    if [ "$BIRD_CONF" != "/etc/bird/bird.conf" ] && [ "$BIRD_SERVICE" = "bird" ]; then
        echo "Error: BIRD_CONF is set to '$BIRD_CONF' but BIRD_SERVICE is still 'bird'." >&2
        echo "Error: Configure a dedicated BIRD systemd service that starts with this config, then set BIRD_SERVICE to that service name." >&2
        exit 1
    fi
}

is_valid_asn() {
    local asn="$1"
    [[ "$asn" =~ ^[0-9]+$ ]] && [ "$asn" -ge 1 ] && [ "$asn" -le 4294967295 ]
}

is_valid_neighbor_address() {
    local address="$1"
    [[ "$address" =~ ^[0-9A-Fa-f:.]+$ ]]
}

# Optional settings (can be overridden in config)
HEALTHCHECK_TIMEOUT_SECONDS="${HEALTHCHECK_TIMEOUT_SECONDS:-2}"
HEALTHCHECK_INTERVAL_SECONDS="${HEALTHCHECK_INTERVAL_SECONDS:-5}"
HEALTHCHECK_SUCCESS_THRESHOLD="${HEALTHCHECK_SUCCESS_THRESHOLD:-2}"
HEALTHCHECK_FAILURE_THRESHOLD="${HEALTHCHECK_FAILURE_THRESHOLD:-2}"
require_positive_integer "HEALTHCHECK_TIMEOUT_SECONDS"
require_positive_integer "HEALTHCHECK_INTERVAL_SECONDS"
require_positive_integer "HEALTHCHECK_SUCCESS_THRESHOLD"
require_positive_integer "HEALTHCHECK_FAILURE_THRESHOLD"

require_var "APP_TYPE"
require_var "ANYCAST_CIDR"
require_var "INTERFACE_NAME"
require_var "ROUTER_ID"
require_var "LOCAL_AS"
require_var "SOURCE_IP"
require_var "NEIGHBORS"
require_var "BFD_INTERVAL"
require_var "BFD_IDLE_TX"
require_var "BFD_MULTIPLIER"
validate_bird_runtime_config

escape_sed_replacement() {
    # Escape backslash, &, and the delimiter (|)
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/&/\\&/g' -e 's/|/\\|/g'
}

escape_birdc_string() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

validate_bird_config() {
    local config_path="$1"

    if ! command -v bird >/dev/null 2>&1; then
        warn "bird command not found; skipping generated config validation."
        return 0
    fi

    if bird -p -c "$config_path" >/dev/null 2>&1; then
        return 0
    fi

    echo "Error: Generated BIRD config failed validation: $config_path" >&2
    return 1
}

run_birdc_configure() {
    local escaped_conf
    escaped_conf="$(escape_birdc_string "$BIRD_CONF")"

    if ! command -v birdc >/dev/null 2>&1; then
        return 1
    fi

    if [ -n "$BIRD_CONTROL_SOCKET" ]; then
        birdc -s "$BIRD_CONTROL_SOCKET" "configure \"$escaped_conf\"" >/dev/null 2>&1
    else
        birdc "configure \"$escaped_conf\"" >/dev/null 2>&1
    fi
}

can_reload_bird_service() {
    [ "$BIRD_CONF" = "/etc/bird/bird.conf" ] || [ "$BIRD_SERVICE" != "bird" ]
}

interface_exists() {
    ip link show dev "$INTERFACE_NAME" >/dev/null 2>&1
}

interface_is_dummy() {
    ip -d -o link show dev "$INTERFACE_NAME" 2>/dev/null | grep -Eq '(^|[[:space:]])dummy([[:space:]]|$)'
}

interface_has_anycast_address() {
    ip -o addr show dev "$INTERFACE_NAME" 2>/dev/null | awk '{print $4}' | grep -Fxq "$ANYCAST_CIDR"
}

# 2. Network Setup Function
setup_interface() {
    log "Setting up interface $INTERFACE_NAME..."

    if interface_exists; then
        if ! interface_is_dummy; then
            echo "Error: Interface $INTERFACE_NAME already exists and is not a dummy interface." >&2
            return 1
        fi
        if ! interface_has_anycast_address; then
            echo "Error: Interface $INTERFACE_NAME already exists but does not have $ANYCAST_CIDR; refusing to replace it." >&2
            return 1
        fi

        log "Removing stale managed dummy interface $INTERFACE_NAME..."
        ip link set "$INTERFACE_NAME" down
        ip link del "$INTERFACE_NAME"
    fi

    # Create dummy interface and assign IP
    ip link add name "$INTERFACE_NAME" type dummy
    INTERFACE_TOUCHED=1
    ip addr add "$ANYCAST_CIDR" dev "$INTERFACE_NAME"

    # IMPORTANT: Initialize state as DOWN to prevent premature advertisement
    ip link set "$INTERFACE_NAME" down
}

# 3. Generate BIRD Config Function
generate_bird_config() {
    log "Generating $BIRD_CONF from template..."
    local tmp_conf="$BIRD_CONF.tmp"
    local neighbor_block=""
    local count=0
    local neighbor
    local neigh_ip
    local neigh_as

    # Dynamically build the neighbor configuration block
    # shellcheck disable=SC2086
    for neighbor in $NEIGHBORS; do
        neigh_ip="${neighbor%:*}"
        neigh_as="${neighbor##*:}"

        if [[ "$neigh_ip" == "$neighbor" || -z "$neigh_ip" || -z "$neigh_as" ]]; then
            warn "Invalid neighbor format '$neighbor'. Expected IP:AS. Skipping."
            continue
        fi
        if ! is_valid_neighbor_address "$neigh_ip" || ! is_valid_asn "$neigh_as"; then
            warn "Invalid neighbor value '$neighbor'. Expected an IP address and numeric AS number. Skipping."
            continue
        fi

        neighbor_block+="protocol bgp upstream_$count from bgp_template { neighbor $neigh_ip as $neigh_as; }\n"
        count=$((count+1))
    done

    if [ "$count" -eq 0 ]; then
        echo "Error: NEIGHBORS must contain at least one valid IP:AS entry in $CONFIG_FILE." >&2
        return 1
    fi

    # Create a temporary config file
    cp "$TEMPLATE_FILE" "$tmp_conf"

    # Replace basic placeholders
    sed -i "s|__ROUTER_ID__|$(escape_sed_replacement "$ROUTER_ID")|g"           "$tmp_conf"
    sed -i "s|__ANYCAST_CIDR__|$(escape_sed_replacement "$ANYCAST_CIDR")|g"     "$tmp_conf"
    sed -i "s|__INTERFACE_NAME__|$(escape_sed_replacement "$INTERFACE_NAME")|g" "$tmp_conf"
    sed -i "s|__LOCAL_AS__|$(escape_sed_replacement "$LOCAL_AS")|g"             "$tmp_conf"
    sed -i "s|__SOURCE_IP__|$(escape_sed_replacement "$SOURCE_IP")|g"           "$tmp_conf"
    
    # Replace BFD placeholders
    sed -i "s|__BFD_INTERVAL__|$(escape_sed_replacement "$BFD_INTERVAL")|g"     "$tmp_conf"
    sed -i "s|__BFD_IDLE_TX__|$(escape_sed_replacement "$BFD_IDLE_TX")|g"       "$tmp_conf"
    sed -i "s|__BFD_MULTIPLIER__|$(escape_sed_replacement "$BFD_MULTIPLIER")|g" "$tmp_conf"
    
    # Insert Neighbor block (remove placeholder and append block)
    sed -i "s|__NEIGHBOR_CONFIG__||g" "$tmp_conf"
    printf '%b' "$neighbor_block" >> "$tmp_conf"

    if ! validate_bird_config "$tmp_conf"; then
        rm -f "$tmp_conf"
        return 1
    fi

    # Apply the new configuration
    mv "$tmp_conf" "$BIRD_CONF"
}

reload_bird() {
    log "Applying BIRD configuration..."

    if ! command -v systemctl >/dev/null 2>&1; then
        echo "Error: systemctl not found; unable to manage BIRD service $BIRD_SERVICE." >&2
        return 1
    fi

    if systemctl is-active --quiet "$BIRD_SERVICE"; then
        if run_birdc_configure; then
            log "BIRD reloaded via 'birdc configure \"$BIRD_CONF\"'."
            return 0
        fi
        warn "'birdc configure \"$BIRD_CONF\"' failed."

        if can_reload_bird_service && systemctl reload "$BIRD_SERVICE" >/dev/null 2>&1; then
            log "BIRD reloaded via 'systemctl reload $BIRD_SERVICE'."
            return 0
        fi

        warn "Failed to reload active BIRD service; refusing to continue with the running daemon unchanged."
        return 1
    fi

    log "BIRD service $BIRD_SERVICE is not active; starting it."
    systemctl start "$BIRD_SERVICE"

    if [ "$BIRD_CONF" != "/etc/bird/bird.conf" ] || [ -n "$BIRD_CONTROL_SOCKET" ]; then
        if run_birdc_configure; then
            log "BIRD applied custom config via 'birdc configure \"$BIRD_CONF\"'."
            return 0
        fi
        warn "Started $BIRD_SERVICE but failed to apply custom BIRD config $BIRD_CONF."
        return 1
    fi

    return 0
}

# 4. Health Check Function
check_health() {
    local tracking

    case "$APP_TYPE" in
        "http")
            # Check HTTP connection to localhost
            curl -s -f --connect-timeout "$HEALTHCHECK_TIMEOUT_SECONDS" --max-time "$HEALTHCHECK_TIMEOUT_SECONDS" -o /dev/null http://127.0.0.1 || return 1
            ;;
        "https")
            # Check HTTPS connection to localhost (ignoring cert errors)
            curl -k -s -f --connect-timeout "$HEALTHCHECK_TIMEOUT_SECONDS" --max-time "$HEALTHCHECK_TIMEOUT_SECONDS" -o /dev/null https://127.0.0.1 || return 1
            ;;
        "ntp")
            # Require chrony synchronization and an absolute offset below 100ms.
            tracking="$(chronyc -c tracking 2>/dev/null)" || return 1
            printf '%s\n' "$tracking" | awk -F, '
                {
                    leap = $NF
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", leap)
                    if (($2 + 0) > 0 && leap == "Normal" && ($5 + 0) < 0.1 && ($5 + 0) > -0.1) exit 0
                    exit 1
                }
            ' || return 1
            ;;
        "dns")
            # Require a successful root NS answer, not just any DNS response.
            dig "+time=${HEALTHCHECK_TIMEOUT_SECONDS}" +tries=1 +noall +answer @127.0.0.1 . NS 2>/dev/null | awk 'NF { found = 1 } END { exit found ? 0 : 1 }' || return 1
            ;;
        "ldap")
            # Check TCP connection to LDAP port 389
            nc -z -w "$HEALTHCHECK_TIMEOUT_SECONDS" 127.0.0.1 389 || return 1
            ;;
        "custom")
            if [ -n "${CUSTOM_CHECK_CMD:-}" ]; then
                if [ ! -x "$CUSTOM_CHECK_CMD" ]; then
                    log "Error: CUSTOM_CHECK_CMD is not executable: $CUSTOM_CHECK_CMD"
                    return 1
                fi
                if command -v timeout >/dev/null 2>&1; then
                    timeout "$HEALTHCHECK_TIMEOUT_SECONDS" "$CUSTOM_CHECK_CMD" || return 1
                else
                    "$CUSTOM_CHECK_CMD" || return 1
                fi
            else
                log "Error: Custom check selected but CUSTOM_CHECK_CMD is empty."
                return 1
            fi
            ;;
        *)
            log "Error: Unknown APP_TYPE: $APP_TYPE"
            return 1
            ;;
    esac
}

# --- Main Execution Logic ---

# Cleanup function to remove interface on service stop
cleanup() {
    local status="${1:-0}"
    trap - EXIT SIGINT SIGTERM
    if [ "$INTERFACE_TOUCHED" != "1" ]; then
        exit "$status"
    fi

    log "Stopping service. Removing interface $INTERFACE_NAME..."
    ip link set "$INTERFACE_NAME" down 2>/dev/null
    ip link del "$INTERFACE_NAME" 2>/dev/null
    exit "$status"
}
trap 'cleanup $?' EXIT
trap 'cleanup 0' SIGINT SIGTERM

# Initialize
# Validate BIRD config before touching the managed interface.
generate_bird_config
setup_interface

reload_bird
# Wait briefly to ensure BIRD has applied config
sleep 2

success_count=0
failure_count=0

log "Starting health check loop for APP_TYPE: $APP_TYPE (success threshold: $HEALTHCHECK_SUCCESS_THRESHOLD, failure threshold: $HEALTHCHECK_FAILURE_THRESHOLD)"

# Loop
while true; do
    # Check current interface state
    IS_UP=$(ip link show "$INTERFACE_NAME" | grep -q "UP" && echo "yes" || echo "no")
    
    if check_health; then
        # Application is HEALTHY
        success_count=$((success_count + 1))
        failure_count=0

        if [ "$IS_UP" == "no" ] && [ "$success_count" -ge "$HEALTHCHECK_SUCCESS_THRESHOLD" ]; then
            log "Health check PASSED $success_count consecutive times. Bringing UP $INTERFACE_NAME (Advertise)."
            ip link set "$INTERFACE_NAME" up
        fi
    else
        # Application is UNHEALTHY
        failure_count=$((failure_count + 1))
        success_count=0

        if [ "$IS_UP" == "yes" ] && [ "$failure_count" -ge "$HEALTHCHECK_FAILURE_THRESHOLD" ]; then
            log "Health check FAILED $failure_count consecutive times. Bringing DOWN $INTERFACE_NAME (Withdraw)."
            ip link set "$INTERFACE_NAME" down
        fi
    fi
    
    sleep "$HEALTHCHECK_INTERVAL_SECONDS"
done
